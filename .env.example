# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=server-only-secret
CLOUDINARY_UPLOAD_FOLDER=haya
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Brevo transactional email
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=bookings@yourdomain.com
BREVO_SENDER_NAME=Haya Premium Bridal Rental

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=server-only-secret
RAZORPAY_WEBHOOK_SECRET=server-only-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000
